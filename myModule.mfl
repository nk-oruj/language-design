module [name]

intern structure [MyStructDesc]
record
    [myConstantInteger] : [1234567]
    [myConstantFractor] : [123.567]

    [myInteger] : [integer]
    [myFractor] : [fractor]

    [myCustom] : [myTypesModule].[Custom]

    [myArray] : array of [integer] scaled [123]
    [myPoint] : point to [fractor]

    [myStructure] : structure
    record
        [aaa] : [integer]
        [bbb] : [fractor]
    finish

    [myProcedure] : procedure
    record
        [aaa] : set [integer]
        [bbb] : get [fractor]
    finish
finish

extern structure [MyStruct] : point to [MyStructDesc]

extern procedure [MyProc]
record
    [aaa] : get [integer]
    [bbb] : set [fractor]

    [ccc] : array of [integer] scaled [123]
    [ddd] : point to [integer]

    [counter] : [integer]
scheme
    ]* expressions & assignments not final? *[
    assign [counter] : [0]
    
    extent [Loop]
      
        depart [Loop] if : [counter] [5] greater_equal

        launch [Out].[PrintInteger]
        record
            [value] : set [counter]
        finish

        assign
            [counter] : [counter] [1] add
        finish

        repeat [Loop]
    
    extent [Loop]

    launch [MyProc]
    record
        [aaa] : set [121434]
        [bbb] : get [myVar]
    finish
finish

finish [name]
